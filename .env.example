# Shopify Client Credentials
VITE_SHOPIFY_CLIENT_ID="your_shopify_client_id"
VITE_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_SECRET="your_shopify_client_secret"
SHOPIFY_ADMIN_API_TOKEN="your_shopify_admin_api_token"

# LINE Login
VITE_LINE_CHANNEL_ID="your_line_channel_id"
LINE_CHANNEL_ID="your_line_channel_id"
LINE_CHANNEL_SECRET="your_line_channel_secret"

# Judge.me Reviews
JUDGEME_PRIVATE_TOKEN="your_judgeme_private_token"

# Slack (optional)
SLACK_WEBHOOK_URL="your_slack_webhook_url"
REPORT_SHOPIFY_CLIENT_ID="your_shopify_client_id"
REPORT_SHOPIFY_CLIENT_SECRET="your_shopify_client_secret"

# Cron protection
CRON_SECRET="your_cron_secret"

# ── Admin Dashboard ──────────────────────────────────────────────
# 어드민 시크릿 키 (biteme.one/admin 로그인에 사용)
ADMIN_SECRET="your_admin_secret_key"
# 로컬 dev에서 Shopify 실데이터를 보려면 프로덕션 ADMIN_SECRET 입력 (Vercel → admin-manage 프로젝트 → Settings → Environment Variables)
PROD_ADMIN_SECRET=""

# Meta Marketing API (광고 성과 + Pixel 이벤트 통계)
# META_ACCESS_TOKEN: Meta 비즈니스 → 시스템 사용자 액세스 토큰 (또는 장기 유저 토큰)
META_ACCESS_TOKEN="your_meta_access_token"
# META_AD_ACCOUNT_ID: 광고 계정 ID (숫자만, act_ 접두사 제외)
META_AD_ACCOUNT_ID="your_ad_account_id"
# META_PIXEL_ID: Meta Pixel ID
META_PIXEL_ID="your_pixel_id"

# Google Analytics 4 (biteme.one GA 연동)
# GA4 Property ID: GA4 콘솔 → 관리 → 속성 → 속성 ID (숫자만, ex: 123456789)
GA4_PROPERTY_ID="your_ga4_property_id"
# Service Account JSON: GCP → IAM → 서비스 계정 → 키 생성 → JSON (한 줄로 직렬화)
GA_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
