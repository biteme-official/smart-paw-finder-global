# Shopify Client Credentials
VITE_SHOPIFY_CLIENT_ID="your_shopify_client_id"
VITE_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_CLIENT_SECRET="your_shopify_client_secret"
SHOPIFY_STOREFRONT_PRIVATE_TOKEN="your_headless_storefront_private_token"
SHOPIFY_ADMIN_API_TOKEN="your_shopify_admin_api_token"

# LINE Login
VITE_LINE_CHANNEL_ID="your_line_channel_id"
LINE_CHANNEL_ID="your_line_channel_id"
LINE_CHANNEL_SECRET="your_line_channel_secret"

# Judge.me Reviews
JUDGEME_PRIVATE_TOKEN="your_judgeme_private_token"

# Slack (optional)
SLACK_WEBHOOK_URL="your_slack_webhook_url"
REPORT_SHOPIFY_CLIENT_ID="your_shopify_client_id"
REPORT_SHOPIFY_CLIENT_SECRET="your_shopify_client_secret"

# Cron protection
CRON_SECRET="your_cron_secret"

# Meta Conversions API (server-side pixel events)
META_PIXEL_ID="your_meta_pixel_id"
META_CAPI_ACCESS_TOKEN="your_meta_capi_access_token"

# Affiliate application → Google Sheets log
# Uses GOOGLE_SERVICE_ACCOUNT_JSON (GA4 uses its own GA4_SERVICE_ACCOUNT_JSON below).
# The target spreadsheet must be shared with the service account's client_email.
AFFILIATE_SHEET_ID="your_affiliate_spreadsheet_id"
AFFILIATE_SHEET_GID="0"

# 사이트 구분 (B2B 사이트 biteme.one은 비워 두면 기존과 동일하게 동작)
# VITE_SITE_URL: B2C 사이트의 실제 접속 주소 (예: https://www.example.com, 끝에 / 없이)
# SITE_MODE: B2C 사이트는 b2c — Slack 리포트 cron 중복 발송 방지
VITE_SITE_URL=""
SITE_MODE=""
